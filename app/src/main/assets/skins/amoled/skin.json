{
  "format": 1,
  "id": "builtin.amoled",
  "name": "AMOLED Black",
  "author": "Naked Music Player",
  "version": "1.0",
  "colors": {
    "mode": "dark",
    "dark": { "primary": "#BB86FC", "background": "#000000", "surface": "#000000" }
  },
  "shapes": { "cornerRadiusDp": 16 },
  "player": {
    "background": { "type": "solid" },
